{
	"info": {
		"name": "Order Execution Engine",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "Execute Order",
			"request": {
				"method": "POST",
				"header": [
					{ "key": "Content-Type", "value": "application/json", "type": "text" }
				],
				"body": {
					"mode": "raw",
					"raw": "{\n    \"inputToken\": \"SOL\",\n    \"outputToken\": \"USDC\",\n    \"amount\": 10\n}"
				},
				"url": {
					"raw": "http://localhost:3000/api/orders/execute",
					"protocol": "http",
					"host": ["localhost"],
					"port": "3000",
					"path": ["api", "orders", "execute"]
				}
			},
			"response": []
		},
		{
			"name": "WebSocket Stream",
			"request": {
				"method": "GET",
				"header": [],
				"url": {
					"raw": "ws://localhost:3000/ws/orders/{{order_id}}",
					"protocol": "ws",
					"host": ["localhost"],
					"port": "3000",
					"path": ["ws", "orders", "{{order_id}}"]
				}
			},
			"response": []
		}
	]
}